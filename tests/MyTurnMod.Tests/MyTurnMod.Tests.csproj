<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The test project directly compiles the pure-logic source files so it doesn't
    need MelonLoader or game assembly references. This keeps tests runnable on any
    machine without a game install.
  -->
  <ItemGroup>
    <Compile Include="..\..\MyTurnMod\NotificationType.cs" />
    <Compile Include="..\..\MyTurnMod\TurnState.cs" />
    <Compile Include="..\..\MyTurnMod\TurnStateTracker.cs" />
    <Compile Include="..\..\MyTurnMod\Platform\IWindowNotifier.cs" />
    <Compile Include="..\..\MyTurnMod\Platform\WindowNotifierFactory.cs" />
    <Compile Include="..\..\MyTurnMod\Platform\NoOpWindowNotifier.cs" />
    <Compile Include="..\..\MyTurnMod\Platform\Mac\INativeAppBridge.cs" />
    <Compile Include="..\..\MyTurnMod\Platform\Mac\MacWindowNotifier.cs" />
    <Compile Include="..\..\MyTurnMod\Platform\Mac\ObjcRuntimeBridge.cs" />
    <Compile Include="..\..\MyTurnMod\Platform\Windows\WindowsWindowNotifier.cs" />
    <Compile Include="..\..\MyTurnMod\Platform\Linux\LinuxWindowNotifier.cs" />
  </ItemGroup>

</Project>
